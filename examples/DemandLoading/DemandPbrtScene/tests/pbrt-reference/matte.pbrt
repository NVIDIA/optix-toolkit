Film "image" "integer xresolution" [32] "integer yresolution" [32] "string filename" ["matte.png"]
Sampler "halton" "integer pixelsamples" [4]
Integrator "path" "integer maxdepth" [4]
LookAt 0 0 4  0 0 0  0 1 0
Camera "perspective" "float fov" [30]

WorldBegin
    LightSource "infinite" "rgb L" [0.25 0.28 0.35]
    LightSource "distant" "rgb L" [3 3 3] "point from" [1 2 4] "point to" [0 0 0]

    Material "matte" "rgb Kd" [0.8 0.2 0.2]
    Shape "sphere" "float radius" [1]
WorldEnd
