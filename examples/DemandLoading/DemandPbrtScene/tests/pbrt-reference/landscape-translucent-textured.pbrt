Film "image" "integer xresolution" [32] "integer yresolution" [32] "string filename" ["gold-landscape-translucent-textured.png"]
Sampler "halton" "integer pixelsamples" [1]
Integrator "directlighting"
LookAt 0 0 4  0 0 0  0 1 0
Camera "perspective" "float fov" [30]

WorldBegin
    LightSource "distant" "rgb L" [1 1 1] "point from" [0 0 -4] "point to" [0 0 0]

    Texture "albedo" "spectrum" "imagemap"
        "string filename" ["landscape-fixture-albedo.png"]
        "bool gamma" ["false"]
        "string wrap" ["clamp"]
    Material "translucent"
        "texture Kd" ["albedo"]
        "rgb Ks" [0 0 0]
        "rgb reflect" [0 0 0]
        "rgb transmit" [1 1 1]
        "float roughness" [0.5]
    Shape "trianglemesh"
        "point P" [
            -1.6 -1.6 0
             1.6 -1.6 0
             1.6  1.6 0
            -1.6  1.6 0
        ]
        "float uv" [
            0 1
            1 1
            1 0
            0 0
        ]
        "integer indices" [
            0 1 2
            0 2 3
        ]
WorldEnd
