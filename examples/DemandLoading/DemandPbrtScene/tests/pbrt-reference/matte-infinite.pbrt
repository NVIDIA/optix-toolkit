Film "image" "integer xresolution" [32] "integer yresolution" [32] "string filename" ["gold-matte-infinite.png"]
Sampler "halton" "integer pixelsamples" [4096]
Integrator "directlighting"
LookAt 0 0 4  0 0 0  0 1 0
Camera "perspective" "float fov" [30]

WorldBegin
    LightSource "infinite"
        "string mapname" ["matte-infinite.exr"]
        "rgb L" [1.0 0.75 0.5]

    Material "matte" "rgb Kd" [0.5 0.4 0.3]
    Shape "trianglemesh"
        "point P" [
            -2 -2 -0.05
             2 -2 -0.05
             2  2 -0.05
            -2  2 -0.05
            -2 -2  0.05
             2 -2  0.05
             2  2  0.05
            -2  2  0.05
        ]
        "integer indices" [
            2 1 0
            0 3 2
            6 5 1
            1 2 6
            7 4 5
            5 6 7
            3 0 4
            4 7 3
            6 2 3
            3 7 6
            1 5 4
            4 0 1
        ]
WorldEnd
