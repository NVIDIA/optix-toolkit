Film "image" "integer xresolution" [32] "integer yresolution" [32] "string filename" ["mix.png"]
Sampler "halton" "integer pixelsamples" [4]
Integrator "path" "integer maxdepth" [4]
LookAt 0 0 4  0 0 0  0 1 0
Camera "perspective" "float fov" [30]

WorldBegin
    LightSource "infinite" "rgb L" [0.25 0.28 0.35]
    LightSource "distant" "rgb L" [3 3 3] "point from" [1 2 4] "point to" [0 0 0]

    MakeNamedMaterial "front" "string type" ["matte"] "rgb Kd" [0.8 0.2 0.2]
    MakeNamedMaterial "back" "string type" ["plastic"] "rgb Kd" [0.2 0.3 0.8]
        "rgb Ks" [0.5 0.5 0.5] "float roughness" [0.2]
    Material "mix" "string namedmaterial1" ["front"] "string namedmaterial2" ["back"] "float amount" [0.35]
    Shape "sphere" "float radius" [1]
WorldEnd
